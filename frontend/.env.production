# ─────────────────────────────────────────────────────────────────────────────
# Frontend — Production Environment Variables
#
# Copy this file to .env.production.local and replace the placeholder URLs
# with your actual deployed backend URL (e.g. your Vercel deployment).
#
# These variables are baked in at BUILD TIME by Create React App.
# Run `npm run build` after editing this file.
# ─────────────────────────────────────────────────────────────────────────────

# Replace <your-vercel-backend-url> with the URL of your deployed backend,
# e.g. https://ci-cd-pipeline-api.vercel.app
#
# When all services are mounted on the same Vercel deployment (via main.py),
# each service is reachable at a sub-path of the same base URL.

REACT_APP_CONTROLLER_URL=https://<your-vercel-backend-url>/pipeline
REACT_APP_ANALYZER_URL=https://<your-vercel-backend-url>
REACT_APP_CLASSIFIER_URL=https://<your-vercel-backend-url>/classifier
REACT_APP_RECOVERY_URL=https://<your-vercel-backend-url>/recovery
REACT_APP_NOTIFICATION_URL=https://<your-vercel-backend-url>/notification
